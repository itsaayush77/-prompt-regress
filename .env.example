# Copy to .env and fill in. Never commit .env.
# Real-model provider (OpenAI-compatible). Leave unset for offline mock mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Public demo mode: force the mock provider, ignore API keys entirely.
DEMO_MODE=false

# Server port.
PORT=4000

# Provider HTTP timeout in ms.
PROMPT_REGRESS_TIMEOUT_MS=30000

# Max POST /api/runs requests per IP per minute.
RATE_LIMIT_PER_MIN=60
